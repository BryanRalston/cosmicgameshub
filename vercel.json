{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/games/holiday-rush",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/games/holiday-rush/",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/games/holiday-rush.html",
      "destination": "/",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/games/rift-words.json",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400, stale-while-revalidate=604800" }
      ]
    },
    {
      "source": "/data/deals.json",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=3600, stale-while-revalidate=86400" }
      ]
    },
    {
      "source": "/data/featured.json",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=300" }
      ]
    },
    {
      "source": "/games/brix3d/:file(brix3d.[0-9a-f]+.(js|css))",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
